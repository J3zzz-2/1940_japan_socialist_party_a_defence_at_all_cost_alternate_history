@politics

= Inter-party Relations


{!<span class="tooltip-text" title="Japanese Liberal Party">JLP</span>!}: [+ jlp_relation : relationships +]

{!<span class="tooltip-text" title="Cooperative Democratic Party">!}[? if not cdp_name: nsp?][? if ddp_name != 0 : [+ cdp_name +]?]{!</span>!}: [+ cdp_relation : relationships +]

{!<span class="tooltip-text" title="Japanese Progressive Party">JPP</span>!}: [+ jpp_relation : relationships +]

